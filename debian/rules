#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	sh debian/fetch-upstream.sh $(CURDIR)/payload/usr/bin

# /etc/crictl.yaml, the sysctl values and the modules list are KubeOS's own static
# files, not administrator-editable defaults: replace them on upgrade (D5).
override_dh_installdeb:
	dh_installdeb
	: > debian/kubeos-network/DEBIAN/conffiles

# The upstream binaries are Go builds with compressed .debug_abbrev sections, which dwz
# refuses to merge ("Found compressed .debug_abbrev section, not attempting dwz
# compression"), and with more than one such file the step aborts the whole build. These
# artefacts are shipped exactly as upstream publishes them, so there is nothing to
# optimise here.
override_dh_dwz:
	@echo "$(shell sed -n 's/^Source:[[:space:]]*//p' debian/control | head -n 1): dwz skipped (upstream Go binaries)"

# dh_installsystemd would enable and start/restart every unit in this package on its own,
# which makes flanneld run: hook 9050 says it must stay disabled, because it cannot run as a
# host service. --no-enable is the whole fix - enabling is the only thing to prevent, and the
# .wants links shipped in the package state exactly which units are enabled on a fresh install.
# --no-start must NOT be added: it also stops the units during an upgrade and never starts
# them again, which took the entire control plane down on 2026-11-19 (measured). Restarting a
# unit around a binary replacement is what Debian does, and it is what we want.
override_dh_installsystemd:
	dh_installsystemd --no-enable
